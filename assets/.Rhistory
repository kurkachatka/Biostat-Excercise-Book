##### Question 2: Is the proportion of DLV different depending on the SIC, the Longitude and Latitude? ####
setwd("/Volumes/Expansion/PhD_data/LA data/LA data 2023/Magda")
DiveSSTBathySIC23MSOM <- read.csv("DiveSSTBathySIC23MSOM.csv",sep=",",dec=".",h=T) ### Comes from Magda_GPSTDRSOM_Enviro
DiveSSTBathySIC23MSOM ## With this model I am losing the information about the LoggerID,
## Check the Longitude and Latitude range:
range(DiveSSTBathySIC23MSOM$Longitude)
range(DiveSSTBathySIC23MSOM$Latitude)
### Look at the number of dives I have happening in August:
datacheck <- DiveSSTBathySIC23MSOM %>% separate(TripID_enddesc, into = c('TripID','Date'), sep = " ") %>%
mutate(Date = as.Date(Date))
str(datacheck)
table(datacheck$Date)
## I should keep full number of DLV that occured and add a coluln for number of trial at that location:
## To use for betabinomial with response = counts and add N.trials = N
PropDLV23M <- DiveSSTBathySIC23MSOM %>%
mutate(LongLatiSIC = paste0(Longitude, sep= " ", Latitude, sep =" ",SIC)) %>%
mutate(DLVvsOther = case_when(ClusterName == "DLV" ~ "DLV",
ClusterName != "DLV" ~ "Other")) %>%
group_by(LongLatiSIC,DLVvsOther) %>%
summarise(counts = n()) %>%
mutate(prop01 = prop.table(counts)) %>%
ungroup() %>%
complete(LongLatiSIC,DLVvsOther, fill = list(counts = 0 ,per = 0)) %>%
mutate(prop01 = ifelse(is.na(prop01),0,prop01)) %>% # replace the NA by 0 in the prop01 column
group_by(LongLatiSIC) %>%
mutate(N = sum(counts)) %>%
ungroup() %>%
filter(DLVvsOther == "DLV") %>%
separate(LongLatiSIC, into = c('Longitude', 'Latitude','SIC'), sep = " ") %>%  # separate every time I have a " "
mutate(SIC = as.numeric(SIC)) %>% # normal message because I have indeed one position with a NA
dplyr::select(-prop01)
PropDLV23M
datacheck <- PropDLV23M %>% mutate(LongLat = paste(Longitude,Latitude))
length(unique(datacheck$LongLat))
## Lean the data set I want to use by removing the NAs and only keeping the column of interest for our question
names(PropDLV23M)
df_Q223M <- PropDLV23M %>%
dplyr::select(Longitude,Latitude,counts,N,SIC) %>%
filter(if_all(.cols = c(1:5), ~ !is.na(.x)))
unique(sort(df_Q223M$SIC))
### Convert my data to spatial data:
df_Q223M_sf <- st_as_sf(df_Q223M,
coords = c("Longitude", "Latitude"),
crs = 4326)
## I need to re-project my data in meters: Project to UTM in meters
df_Q223M_sf_utm <- st_transform(df_Q223M_sf, 32633)
## Extract coordinates in meters
coords23_Q223M <- st_coordinates(df_Q223M_sf_utm)
### Clean data that need to use:
df_Q223Mc <- df_Q223M %>%
bind_cols(coords23_Q223M) %>%
mutate(SIC = as.numeric(SIC)) %>%
dplyr::select(-c(Longitude,Latitude))
str(df_Q223Mc)
colSums(is.na(df_Q223Mc)) ## all good no NA
### 1. Perform model selection in INLA: Here the models are build without taking into account the spatial aspect => equivalent to a GLMM
## Specify the formula: Without random ID
## I need to use the "xbinomial" family as I want values to be non-integer: https://inla.r-inla-download.org/r-inla.org/doc/likelihood/binomial.pdf
resp_Q223M <- "counts"
covar_Q223M <- c("SIC")
phen_Q223M <- c("X","Y")
f01_Q223M <- as.formula(paste0(resp_Q223M, "~", # Response first
paste(covar_Q223M, collapse = "+"))) ## Collapse the vector of covariates
## Run the model
IM01_Q223M  <- inla(f01_Q223M,
family = "betabinomial", # Specify the family. Can be a wide range (see r-inla.org).
Ntrials = df_Q223Mc$N,
data = df_Q223Mc,   # Specify the data
control.compute = list(dic = TRUE),
control.fixed = list(mean = 0, prec = 1)
)
summary(IM01_Q223M)
## Look at the DIC:
## Why use betabinomial: We know the total trials per GPS poi,nt but we also know that there is quite a lot of variation
IM01_Q223M$dic$dic ## betabinomial (900.0708) / xbinomial(992.5621) / When I use the full number as a response variable (binomial) = 1437.895
## Model with the name 2.5bufferandoffset:
mesh_Q223M <- inla.mesh.2d(loc = coords23_Q223M,
max.edge = c(1500,3000), ## inner triangle size when data point are recorded, and outer triangle when no data point are recorded
## Resolution of 1.5 km vs 3 km
cutoff = 300,
offset = c(25000, 40000)) ## I need to add an offset because the blue square if falling out of my mesh
plot(mesh_Q223M)
points(coords23_Q223M, col="red", pch=16)
### 3. Define the SPDE model: SPDE = "Stochastic Partial Differential Equation  => this is INLA’s way to model continuous spatial autocorrelation on the mesh
## Compute pairwise distance matrix:
D_Q223M <- dist(coords23_Q223M)
## median pairwise distance:
d50_Q223M <- median(D_Q223M)
d50_Q223M ## 56234.43m => used as the value in the prior.range
### Use of the sd of the response as a value of sigma0: estimate theta 50% of the prior mass on a spatial sd larger than the observed sd
sd_y_Q223M <- sd(df_Q223Mc$counts, na.rm = TRUE)
sd_y_Q223M ## 8.471179
## This step calculate the link between my dives taking into account that they might be autocorrelated in space
spde_Q223M <- inla.spde2.pcmatern(
mesh = mesh_Q223M,
alpha = 2,
prior.range = c(3000, 0.5), # Estimation over which the diving depth is correlated
#P(250): we consider that two point apart from 5km should be considered correlated beyond the correlation fade
#P(0.5): “There is a 50% chance that the correlation range is smaller than 5 km.”
prior.sigma = c(1500, 0.05)) # How much variation the spatial surface is allowed to show => “There is only 5% chance that spatial variability exceeds the marginal SD of the data”
## Create data structure for prediction
A_Q223M <- inla.spde.make.A(mesh_Q223M, loc = coords23_Q223M) ## create the projector matrix A
dim(A_Q223M)
spde_Q223M_index <- inla.spde.make.index("spatial", n.spde = spde_Q223M$n.spde) ## create the list of named index vectors for the SPDE model
## This piece of code is creating a "table" including the spatial information which I need to test different model:
stack_Q223M <- inla.stack(
data = list(y = df_Q223Mc$counts, ## Number of DLV
Ntrials = df_Q223Mc$N), ## Number of trial
A = list(A_Q223M, 1), ## Compute the spatial effect at each depth measurement
effects = list(
spatial = spde_Q223M_index, ## how many spatial nodes exist, and how they connect
data.frame(
Intercept = 1,
SIC = df_Q223Mc$SIC)),
tag = "data" ## to discriminate with the one of the prediction, just added in January
)
## Re-build the model to see which variables would be a better fit to understand my data distribution:
## Model only with the fix effect
f0_Q223M <- y ~ -1 + Intercept + SIC
IM0_Q223M <- inla(f0_Q223M,
family = "betabinomial",
data = inla.stack.data(stack_Q223M),
Ntrials = inla.stack.data(stack_Q223M)$Ntrials,
control.predictor = list(A = inla.stack.A(stack_Q223M),compute = T),
control.compute = list(dic = TRUE),
control.fixed = list(mean = 0, prec = 1))
summary(IM0_Q223M)
## Model with the fix effect + Spatial effect
## Takes around 8 min to run when PC prior are set to 3000 & 1500 with no convergence error message
f1_Q223M <- y ~ -1 + Intercept + SIC + f(spatial, model=spde_Q223M)
#saveRDS(IM1_Q223M2.5bufferoffset,file="/Volumes/Expansion/PhD_data/LA data/LA data 2023/Magda/IM1_Q223Moffset.RData") ## DIC: 593.8243 => not optimal
#saveRDS(IM1_Q223Moffset,file="/Volumes/Expansion/PhD_data/LA data/LA data 2023/Magda/IM1_Q223Moffset.RData")
#saveRDS(IM1_Q223M,file="/Volumes/Expansion/PhD_data/LA data/LA data 2023/Magda/IM1_Q223M.RData")
IM1_Q223M <- readRDS("/Volumes/Expansion/PhD_data/LA data/LA data 2023/Magda/IM1_Q223M.RData")
IM0_Q223M$dic$dic # SIC: betabinomial (900.1138) / xbinomial (20963.1)
IM1_Q223M$dic$dic # SIC + Spatial effect: betabinomial (580.7406) => best model
### How to interpret the results of this model = best model
summary(mD4_Q123M)
summary(IM1_Q223M)
