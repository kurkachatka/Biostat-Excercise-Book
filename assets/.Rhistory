data = list(y = df_Q123Mc$bottdep.mean), ## What were the observed depth
A = list(A_Q123M, 1), ## Compute the spatial effect at each depth measurement
effects = list(
spatial = spde_Q123M_index, ## how many spatial nodes exist, and how they connect
data.frame(
Intercept = 1,
SIC = df_Q123Mc$SIC,
bathy = df_Q123Mc$bathy,
LoggerID = df_Q123Mc$LoggerID,
TripID = df_Q123Mc$TripID)), ## what the LoggerID is for each row
tag = "data" ## to discriminate with the one of the prediction, just added in January
)
