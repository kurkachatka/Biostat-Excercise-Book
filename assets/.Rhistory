d50_Q123M ## 56234.43m => used as the value in the prior.range
## This step calculate the link between my dives taking into account that they might be autocorrelated in space
spde_Q123M <- inla.spde2.pcmatern(
mesh = mesh_Q123M,
alpha = 2,
prior.range = c(d50_Q123M, 0.5), # Estimation over which the diving depth is correlated
#P(250): we consider that two point apart from 5km should be considered correlated beyond the correlation fade
#P(0.5): “There is a 50% chance that the correlation range is smaller than 5 km.”
prior.sigma = c(sd_y_Q123M, 0.05)) # How much variation the spatial surface is allowed to show => “There is only 5% chance that spatial variability exceeds the marginal SD of the data”
